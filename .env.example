# Copy this file to .env at the repo root (used by `docker compose up`) and fill in real
# values. .env is gitignored — never commit it with real values.

# --- Backend (required) ---
# Required — the API fails to start without this. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# --- Backend (optional — defaults shown are used if unset) ---
# "development" (default) or "production". ENVIRONMENT=production forces COOKIE_SECURE=True
# regardless of the COOKIE_SECURE value below.
ENVIRONMENT=development

# Postgres connection string (async driver). Docker Compose overrides this to use the `db`
# service hostname automatically — only set this yourself when running the API outside Docker.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/uptime

# Only needed in production (Neon) — see backend/README.md's "DATABASE_URL (production —
# Neon)" section. Alembic's migration step uses this instead of DATABASE_URL when it's set;
# unset locally, so local migrations keep using DATABASE_URL exactly as before.
# MIGRATION_DATABASE_URL=

# Only needed in production (Neon) — a direct (non-pooled) connection string, used only by
# realtime.py's single long-lived LISTEN connection. Neon's pooled DATABASE_URL doesn't
# reliably deliver NOTIFYs to a LISTEN session (see backend/README.md). Unset locally, so the
# listener keeps using DATABASE_URL exactly as before (no pooler in local/Docker Compose
# Postgres, so the distinction doesn't matter there).
# LISTEN_DATABASE_URL=

# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=10080
# COOKIE_NAME=session
# COOKIE_HTTP_ONLY=true
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax
# COOKIE_MAX_AGE=604800

# Comma-separated list of allowed CORS origins (never a wildcard — the API sends credentialed
# cookies). Defaults to the local frontend dev server; set to the real Vercel domain(s) in
# production.
# CORS_ORIGINS=http://localhost:3000

# Base URL the backend uses to build links in outgoing email (detail page, settings page,
# password reset). Defaults to the local frontend dev server; set to the real Vercel domain
# in production.
# FRONTEND_URL=http://localhost:3000

# Resend API key for transactional email (downtime/cert-expiry alerts, password reset).
# Optional — unlike JWT_SECRET, leaving this unset does not stop the app from starting; email
# sending just no-ops (logged, not sent). Get a key at https://resend.com.
# RESEND_API_KEY=
# Sender identity for outgoing mail. Defaults to Resend's sandbox address, which works without
# a verified domain — fine for dev/testing. Override once a real domain is verified.
# RESEND_FROM_EMAIL=Uptime Monitor <onboarding@resend.dev>

# --- Worker (optional — defaults shown are used if unset) ---
# CHECK_INTERVAL_SECONDS=300
# HTTP_TIMEOUT_SECONDS=10
# HTTP_VERIFY_SSL=true
# Identifies which region this worker instance checks from — tagged onto log lines now, and
# onto checks rows once Phase 2's multi-region schema migration lands. Defaults to "local" for
# single-instance dev; set a real value (e.g. "us-east", "eu-west") per worker instance once
# more than one is running.
# REGION=local

# --- Frontend ---
# Set in frontend/.env.local (Next.js convention), not here.
# NEXT_PUBLIC_API_URL=http://localhost:8000
